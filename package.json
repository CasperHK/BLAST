{
  "name": "blast",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "encore run",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "gen:types": "npm run gen:types --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
