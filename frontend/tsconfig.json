{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "paths": {
      "~/.encore/*": ["./.encore/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
